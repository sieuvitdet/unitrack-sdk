# Build outputs
build/
dist/
*.o
*.a
*.so
*.dylib
*.aar

# C++
core/third_party/sqlite3/sqlite3.c
core/third_party/sqlite3/sqlite3.h

# Native SDK + C core vendored into the iOS Flutter pod via sync_native.sh.
# Tracked in git because `flutter pub publish` filters by `git ls-files` —
# untracked files NEVER end up in the published archive, even if .pubignore
# wants to keep them. Re-run sync_native.sh whenever source iOS / core changes,
# then commit the diff. Keep Pods/Podfile.lock ignored separately (above).
# platforms/flutter/ios/Native/
# platforms/flutter/ios/Classes/include/unitrack.h

# iOS
*.xcframework
DerivedData/
*.xcuserstate
xcuserdata/
# Generated Xcode projects + dependency artifacts in the demos (regenerate with
# `ruby gen_project.rb`). CocoaPods (legacy) + Swift Package local state.
Pods/
*.xcworkspace/
Podfile.lock
.swiftpm/
ios-camera-demo/UniTrackCameraDemo.xcodeproj/
ios-uikit-demo/UniTrackUIKitDemo.xcodeproj/

# Android
.gradle/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Node / RN
node_modules/
*.tgz
dist/
*.log
package-lock.json

# RN native sync artifacts (produced by platforms/react-native/ios/sync_native.sh).
# Keep tracked in git so `npm publish` sees them (same reason as Flutter — npm
# also respects .gitignore via the npm-packlist algorithm for npm 7+).
# platforms/react-native/ios/Native/
# platforms/react-native/ios/include/

# SPM resolution lock (regenerated on each resolve).
platforms/ios/Package.resolved

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
pubspec.lock

# OS
.DS_Store
Thumbs.db

# Backend
backend/ingest.db*

# Vendored C core copy for the CocoaPods build (regenerate with platforms/ios/sync_core.sh)
platforms/ios/CoreVendor/

# SPM build cache (regenerated)
platforms/ios/.build/

# Portal local database (runtime data, not source)
portal/data/
.claude/

# Android demo build artifacts
android-camera-demo/.gradle/
android-camera-demo/build/
android-camera-demo/app/build/
android-camera-demo/.idea/
android-camera-demo/local.properties

# Demo apps — kept out of the public SDK repo. They consume the SDK as
# external artifacts (JitPack / Swift Package URL); their source lives in
# their own repos (or just on developer machines for now).
android-camera-demo/
ios-camera-demo/
ios-uikit-demo/
react-native-demo/
flutter-tracking-app/
examples/

# Web SDK demo: chứa API key thật của project 9 trên portal production
# (showcase/torture/index.html). Repo public nên không commit. Bản đang chạy
# sống trên VPS: /root/event-tracking-portal/public/unitrack-web-demo/
platforms/web/demo/

# Lock file của web SDK: cần để build tái lập được đúng version dependency.
# .gitignore:50 chặn package-lock.json toàn repo, nhưng react-native/ và
# portal/ đã commit lock file từ trước — mở ngoại lệ cho web để nhất quán.
!platforms/web/package-lock.json
